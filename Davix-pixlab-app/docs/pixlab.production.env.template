#############################################
# PixLab — Production Environment Template
#
# Core environment configuration for PixLab.
# This template contains runtime, security,
# networking, authentication, and integration
# variables used by the PixLab service.
#
# Sensitive values are replaced with
# placeholders and must be configured
# before running PixLab in production.
#############################################

ENV_FILE=<ENV_FILE_PATH>

PUBLIC_BASE_URL=https://pixlab.davix.dev

API_KEYS=<PIXLAB_API_KEYS>
PUBLIC_API_KEYS=<PIXLAB_PUBLIC_API_KEYS>

NODE_ENV=production
PORT=3005

CORS_ORIGINS=<ALLOWED_CORS_ORIGINS>

AUTO_RUN_MIGRATIONS=true
BODY_PARSER_JSON_LIMIT=1mb

INTERNAL_ALLOWED_IPS=<INTERNAL_ALLOWED_IPS>
INTERNAL_BASE_URL=<INTERNAL_BASE_URL>

OUTPUT_CACHE_CONTROL=private, no-store

DB_HOST=<DB_HOST>
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASS=<DB_PASSWORD>

PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
PUPPETEER_NO_SANDBOX=false

PIXLAB_RENEWAL_URL=<PIXLAB_RENEWAL_URL>

REQUIRE_SIGNED_OUTPUT_URLS=true
SIGNED_URL_ALGO=sha256
SIGNED_URL_SECRET=<SIGNED_URL_SECRET>
SIGNED_URL_TTL_SECONDS=86400

SUBSCRIPTION_BRIDGE_TOKEN=<SUBSCRIPTION_BRIDGE_TOKEN>

SUPPORT_EMAIL=<SUPPORT_EMAIL>
SUPPORT_URL=<SUPPORT_URL>

TRUST_PROXY=1
WEBSITE_URL=<WEBSITE_URL>

ADMIN_PASS=<ADMIN_PASSWORD>
ADMIN_PASSWORD_HASH=<ADMIN_PASSWORD_HASH>
ADMIN_PATH=<ADMIN_PANEL_PATH>
ADMIN_SESSION_SECRET=<ADMIN_SESSION_SECRET>
ADMIN_TOTP_SECRET=<ADMIN_TOTP_SECRET>

ALERT_EMAIL_FROM=<ALERT_EMAIL_FROM>
ALERT_EMAIL_HOST=<ALERT_EMAIL_HOST>
ALERT_EMAIL_JSON_TRANSPORT=<ALERT_EMAIL_JSON_TRANSPORT>
ALERT_EMAIL_PASS=<ALERT_EMAIL_PASSWORD>
ALERT_EMAIL_PORT=587
ALERT_EMAIL_SECURE=<ALERT_EMAIL_SECURE>
ALERT_EMAIL_USER=<ALERT_EMAIL_USER>

ALERT_TELEGRAM_ENABLED=<ALERT_TELEGRAM_ENABLED>
ALERT_TELEGRAM_API_BASE_URL=<ALERT_TELEGRAM_API_BASE_URL>
ALERT_TELEGRAM_BOT_TOKEN=<ALERT_TELEGRAM_BOT_TOKEN>
