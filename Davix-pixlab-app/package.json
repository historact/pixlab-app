{
  "name": "davix-pixlab",
  "version": "1.0.0",
  "description": "Davix PixLab is a production-grade HTML-to-Image and Image Editing API platform by Davix Labs, providing secure rendering, PDF processing, and advanced image transformation services. Distributed and sold through Davix H2I.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "migrations:status": "node scripts/migrations-status.js",
    "migrations:rerun-check": "node scripts/migrations-rerun-check.js",
    "verify-schema": "node scripts/verify-schema.js",
    "verify:prod": "node scripts/verify-production.js",
    "install:clean": "test -f package-lock.json && npm ci"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "express-mysql-session": "^2.1.8",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.15.0",
    "sharp": "^0.33.0",
    "uuid": "^9.0.1",
    "mysql2": "^3.11.0"
  },
  "optionalDependencies": {
    "argon2": "^0.41.1"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/davix-labs/pixlab.git"
  }
}
