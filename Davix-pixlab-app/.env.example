# Core
NODE_ENV=development  # default: unset => treated as non-production (isProduction checks === "production") | type: string enum | accepted: production (enables prod defaults) or any other string | meaning: production=enable stricter defaults, non-production=dev defaults | units: n/a | effect: toggles prod-only defaults for signing/query keys/sandbox
PORT=3005  # default: 3005 | type: integer | accepted: base-10 port number | meaning: 3005=listen on port 3005 | units: TCP port | effect: changes server listen port
BASE_URL=http://localhost:3005  # default: http://localhost:${PORT} | type: string URL | accepted: full URL with scheme/host/port | meaning: public base URL for signed/static outputs | units: n/a | effect: affects output URLs returned to clients
TRUST_PROXY=true  # default: true | type: boolean/number string | accepted: true/false or integer hops (other strings => true) | meaning: true=trust proxy headers, false=ignore, number=trusted hop count | units: n/a | effect: changes client IP/proxy handling

# CORS
CORS_ORIGINS=https://h2i.davix.dev,https://davix.dev,https://www.davix.dev  # default: listed origins | type: list | accepted: comma-separated URLs, trimmed | meaning: list of allowed CORS origins | units: n/a | effect: controls Access-Control-Allow-Origin allowlist

# Auth & Keys
API_KEYS=  # default: empty | type: list | accepted: comma/whitespace-separated, trimmed | meaning: master allowlist of valid API keys | units: n/a | effect: REQUIRED in production; controls which keys are accepted
PUBLIC_API_KEYS=  # default: empty | type: list | accepted: comma/whitespace-separated, trimmed | meaning: subset of API_KEYS treated as public | units: n/a | effect: public keys get public rate limits
DISABLE_QUERY_API_KEY_IN_PROD=1  # default: true | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=disable ?key= in prod, 0/false=allow | units: n/a | effect: controls query-string API key allowance in production
SUBSCRIPTION_BRIDGE_TOKEN=  # default: empty | type: string | accepted: any non-empty string | meaning: shared secret for /internal routes | units: n/a | effect: protects internal subscription/admin endpoints (recommended in production)
X_DAVIX_BRIDGE_TOKEN=  # default: empty | type: string | accepted: any non-empty string | meaning: legacy alias for SUBSCRIPTION_BRIDGE_TOKEN | units: n/a | effect: used as fallback when SUBSCRIPTION_BRIDGE_TOKEN is unset

# Database
DB_HOST=  # default: localhost | type: string | accepted: hostname/IP | meaning: DB host to connect to | units: n/a | effect: REQUIRED in production; changes DB host
DB_USER=  # default: root | type: string | accepted: DB username | meaning: DB user account | units: n/a | effect: REQUIRED in production; changes DB auth user
DB_PASS=  # default: empty | type: string | accepted: DB password | meaning: password for DB_USER | units: n/a | effect: changes DB auth password
DB_NAME=  # default: pixlab | type: string | accepted: database name | meaning: DB schema name | units: n/a | effect: REQUIRED in production; changes target database

# Signing & Outputs
REQUIRE_SIGNED_OUTPUT_URLS=1  # default: true in production, false otherwise | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=require signed static URLs, 0/false=allow unsigned | units: n/a | effect: toggles signed URL enforcement for output files
SIGNED_URL_SECRET=  # default: empty | type: string | accepted: non-empty secret | meaning: HMAC secret used to sign output URLs | units: n/a | effect: REQUIRED in production when signing is enabled
SIGNED_URL_TTL_SECONDS=86400  # default: 86400 | type: integer | accepted: base-10 seconds | meaning: 86400=24h URL lifetime | units: seconds | effect: changes signed URL expiration window
SIGNED_URL_ALGO=sha256  # default: sha256 | type: string | accepted: crypto HMAC algorithm name (e.g., sha256, sha512) | meaning: selects HMAC hash algorithm | units: n/a | effect: changes signature algorithm for signed URLs
OUTPUT_CACHE_CONTROL=private, no-store  # default: private, no-store | type: string | accepted: HTTP Cache-Control value | meaning: cache directives for static outputs | units: n/a | effect: changes Cache-Control response header
PUBLIC_FILE_TTL_HOURS=24  # default: 24 | type: integer | accepted: base-10 hours > 0 | meaning: 24=delete output files after 24 hours | units: hours | effect: controls cleanup age for stored output files

# H2I / Puppeteer / SSRF
MAX_HTML_CHARS=100000  # default: 100000 | type: integer | accepted: base-10 count > 0 | meaning: 100000=max HTML chars per request | units: characters | effect: caps HTML payload size
MAX_RENDER_PIXELS=20000000  # default: 20000000 | type: integer | accepted: base-10 count > 0 | meaning: 20000000=max render pixels | units: pixels | effect: caps render surface area
MAX_RENDER_WIDTH=5000  # default: 5000 | type: integer | accepted: base-10 pixels > 0 | meaning: 5000=max render width | units: pixels | effect: caps render width
MAX_RENDER_HEIGHT=8000  # default: 8000 | type: integer | accepted: base-10 pixels > 0 | meaning: 8000=max render height | units: pixels | effect: caps render height
H2I_BLOCK_PRIVATE_NETWORK=1  # default: true | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=block private/localhost SSRF, 0/false=allow | units: n/a | effect: controls private network SSRF blocking for H2I
H2I_ALLOW_FILE_SCHEME=0  # default: false | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=allow file: URLs, 0/false=block | units: n/a | effect: controls file:// access in H2I renderer
H2I_DNS_REBINDING_MODE=strict  # default: strict in production when H2I_BLOCK_PRIVATE_NETWORK=true, else off | type: enum | accepted: off, strict, pin | meaning: off=single resolve, strict=resolve per request, pin=pin first resolution | units: n/a | effect: controls DNS rebinding defense behavior
PUPPETEER_NO_SANDBOX=0  # default: true in non-production, false in production | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=disable Chromium sandbox, 0/false=use sandbox | units: n/a | effect: controls Puppeteer sandbox flags

# Limits & Uploads
BODY_PARSER_JSON_LIMIT=20mb  # default: 20mb | type: string | accepted: body-parser size strings (e.g., 100kb, 1mb, 20mb) | meaning: max JSON body size | units: bytes w/ suffix | effect: caps JSON payload size
MAX_UPLOAD_BYTES=10485760  # default: 10MB when unset | type: integer | accepted: base-10 bytes | meaning: 10485760=10MB per file | units: bytes | effect: per-file upload size cap

# Timeouts
PUBLIC_TIMEOUT_MS=30000  # default: 30000 | type: integer | accepted: base-10 ms | meaning: 30000=30s per request | units: milliseconds | effect: timeout for public requests
OWNER_TIMEOUT_MS=300000  # default: 300000 | type: integer | accepted: base-10 ms | meaning: 300000=5 minutes per request | units: milliseconds | effect: timeout for owner requests

# Upload limits (public)
PUBLIC_IMAGE_MAX_FILES_PER_REQ=10  # default: 10 | type: integer | accepted: base-10 count > 0 | meaning: 10=up to 10 images per request | units: count | effect: caps public image files per request
PUBLIC_IMAGE_MAX_TOTAL_UPLOAD_MB=10  # default: 10 | type: integer | accepted: base-10 MB > 0 | meaning: 10=10MB total per request | units: MB | effect: caps public image upload size
PUBLIC_IMAGE_MAX_DIMENSION_PX=6000  # default: 6000 | type: integer | accepted: base-10 pixels > 0 | meaning: 6000=max width/height per image | units: pixels | effect: caps public image dimensions
PUBLIC_PDF_MAX_FILES_PER_REQ=10  # default: 10 | type: integer | accepted: base-10 count > 0 | meaning: 10=up to 10 PDFs per request | units: count | effect: caps public PDF files per request
PUBLIC_PDF_MAX_TOTAL_UPLOAD_MB=10  # default: 10 | type: integer | accepted: base-10 MB > 0 | meaning: 10=10MB total per request | units: MB | effect: caps public PDF upload size
PUBLIC_TOOLS_MAX_FILES_PER_REQ=10  # default: 10 | type: integer | accepted: base-10 count > 0 | meaning: 10=up to 10 files per request | units: count | effect: caps public tools files per request
PUBLIC_TOOLS_MAX_TOTAL_UPLOAD_MB=10  # default: 10 | type: integer | accepted: base-10 MB > 0 | meaning: 10=10MB total per request | units: MB | effect: caps public tools upload size
PUBLIC_TOOLS_MAX_DIMENSION_PX=6000  # default: 6000 | type: integer | accepted: base-10 pixels > 0 | meaning: 6000=max width/height per image | units: pixels | effect: caps public tools image dimensions

# Upload limits (owner)
OWNER_MAX_FILES_PER_REQ=50  # default: 50 | type: integer | accepted: base-10 count > 0 | meaning: 50=up to 50 files per request | units: count | effect: caps owner files per request (owners otherwise unlimited)
OWNER_IMAGE_MAX_TOTAL_UPLOAD_MB=  # default: unlimited | type: integer | accepted: base-10 MB > 0 | meaning: blank=unlimited, number=capped total | units: MB | effect: caps owner image upload size
OWNER_IMAGE_MAX_DIMENSION_PX=  # default: unlimited | type: integer | accepted: base-10 pixels > 0 | meaning: blank=unlimited, number=capped dimension | units: pixels | effect: caps owner image dimensions
OWNER_PDF_MAX_TOTAL_UPLOAD_MB=  # default: unlimited | type: integer | accepted: base-10 MB > 0 | meaning: blank=unlimited, number=capped total | units: MB | effect: caps owner PDF upload size
OWNER_TOOLS_MAX_TOTAL_UPLOAD_MB=  # default: unlimited | type: integer | accepted: base-10 MB > 0 | meaning: blank=unlimited, number=capped total | units: MB | effect: caps owner tools upload size
OWNER_TOOLS_MAX_DIMENSION_PX=  # default: unlimited | type: integer | accepted: base-10 pixels > 0 | meaning: blank=unlimited, number=capped dimension | units: pixels | effect: caps owner tools image dimensions

# Global ceilings
GLOBAL_MAX_TOTAL_UPLOAD_MB=  # default: unlimited | type: float | accepted: base-10 MB > 0 | meaning: blank=unlimited, number=capped total | units: MB | effect: global ceiling for total upload size per request
GLOBAL_MAX_FILES_PER_REQ=  # default: unlimited | type: integer | accepted: base-10 count > 0 | meaning: blank=unlimited, number=capped count | units: count | effect: global ceiling for files per request

# Rate limits (public)
PUBLIC_H2I_DAILY_LIMIT=5  # default: 5 | type: integer | accepted: base-10 count > 0 | meaning: 5=public H2I calls/day per IP | units: count/day | effect: caps public H2I usage per day
PUBLIC_IMAGE_DAILY_LIMIT=10  # default: 10 | type: integer | accepted: base-10 count > 0 | meaning: 10=public image files/day per IP | units: files/day | effect: caps public image usage per day
PUBLIC_PDF_DAILY_LIMIT=10  # default: 10 | type: integer | accepted: base-10 count > 0 | meaning: 10=public PDFs/day per IP | units: files/day | effect: caps public PDF usage per day
PUBLIC_TOOLS_DAILY_LIMIT=10  # default: 10 | type: integer | accepted: base-10 count > 0 | meaning: 10=public tools files/day per IP | units: files/day | effect: caps public tools usage per day

# Burst limits (customer)
CUSTOMER_BURST_LIMIT_PER_MIN=0  # default: 0 | type: integer | accepted: base-10 count >= 0 | meaning: 0=disabled, >0=limit requests per window | units: requests/min | effect: caps customer burst rate
CUSTOMER_BURST_WINDOW_SECONDS=60  # default: 60 | type: integer | accepted: base-10 seconds > 0 | meaning: 60=1-minute window | units: seconds | effect: sets burst counting window size
CUSTOMER_BURST_APPLIES_TO=h2i  # default: h2i | type: enum | accepted: h2i, all | meaning: h2i=limit only /v1/h2i, all=all endpoints | units: n/a | effect: controls burst limiter scope
RATE_LIMIT_DB_FAILURE_MODE=memory  # default: memory | type: enum | accepted: memory, open, closed | meaning: memory=fallback in-process, open=allow, closed=reject | units: n/a | effect: controls daily limiter behavior on DB failure

# Retention & Cleanup
EXPIRY_WATCHER_ENABLED=true  # default: true (enabled unless set to "false") | type: string flag | accepted: "false" disables, any other value enables | meaning: false=disabled, anything else=enabled | units: n/a | effect: toggles expiry watcher job
EXPIRY_WATCHER_INTERVAL_MS=600000  # default: 600000 | type: integer | accepted: base-10 ms > 0 | meaning: 600000=10 minutes | units: milliseconds | effect: sets expiry watcher interval
EXPIRY_WATCHER_BATCH_SIZE=500  # default: 500 | type: integer | accepted: base-10 count > 0 | meaning: 500=records per batch | units: count | effect: sets expiry watcher batch size
ORPHAN_CLEANUP_ENABLED=true  # default: true (enabled unless set to "false") | type: string flag | accepted: "false" disables, any other value enables | meaning: false=disabled, anything else=enabled | units: n/a | effect: toggles orphan cleanup job
ORPHAN_CLEANUP_INTERVAL_MS=86400000  # default: 86400000 | type: integer | accepted: base-10 ms > 0 | meaning: 86400000=24 hours | units: milliseconds | effect: sets orphan cleanup interval
ORPHAN_CLEANUP_INITIAL_DELAY_MS=300000  # default: 300000 | type: integer | accepted: base-10 ms > 0 | meaning: 300000=5 minutes | units: milliseconds | effect: sets orphan cleanup initial delay
ORPHAN_CLEANUP_BATCH=5000  # default: 5000 | type: integer | accepted: base-10 count > 0 | meaning: 5000=rows per batch | units: count | effect: sets orphan cleanup batch size
RETENTION_CLEANUP_ENABLED=true  # default: true (enabled unless set to "false") | type: string flag | accepted: "false" disables, any other value enables | meaning: false=disabled, anything else=enabled | units: n/a | effect: toggles retention cleanup job
RETENTION_CLEANUP_INTERVAL_MS=86400000  # default: 86400000 | type: integer | accepted: base-10 ms > 0 | meaning: 86400000=24 hours | units: milliseconds | effect: sets retention cleanup interval
RETENTION_INITIAL_DELAY_MS=60000  # default: 60000 | type: integer | accepted: base-10 ms > 0 | meaning: 60000=1 minute | units: milliseconds | effect: sets retention cleanup initial delay
RETENTION_REQUEST_LOG_DAYS=60  # default: 60 | type: integer | accepted: base-10 days >= 1 | meaning: 60=keep request_log for 60 days | units: days | effect: controls request_log retention window
RETENTION_USAGE_MONTHLY_MONTHS=6  # default: 6 | type: integer | accepted: base-10 months >= 1 | meaning: 6=keep usage_monthly for 6 months | units: months | effect: controls usage_monthly retention window
RETENTION_BATCH_REQUEST_LOG=20000  # default: 20000 | type: integer | accepted: base-10 count > 0 | meaning: 20000=rows per cleanup batch | units: count | effect: sets retention cleanup batch size for request_log
RETENTION_BATCH_USAGE_MONTHLY=5000  # default: 5000 | type: integer | accepted: base-10 count > 0 | meaning: 5000=rows per cleanup batch | units: count | effect: sets retention cleanup batch size for usage/monthly limits
RETENTION_RATE_LIMIT_DAYS=  # default: fallback (2 days daily limits, 7 days burst) | type: integer | accepted: base-10 days >= 1 | meaning: blank=use per-table defaults, number=shared retention days | units: days | effect: sets shared retention fallback for rate/burst limits
RATE_LIMITS_DAILY_CLEANUP_ENABLED=true  # default: true | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=enable cleanup, 0/false=disable | units: n/a | effect: toggles rate_limits_daily retention cleanup
RATE_LIMITS_DAILY_RETENTION_DAYS=2  # default: 2 (or RETENTION_RATE_LIMIT_DAYS) | type: integer | accepted: base-10 days >= 1 | meaning: 2=keep daily limits 2 days | units: days | effect: sets rate_limits_daily retention window
BURST_LIMITS_WINDOW_CLEANUP_ENABLED=true  # default: true | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=enable cleanup, 0/false=disable | units: n/a | effect: toggles burst_limits_window retention cleanup
BURST_LIMITS_WINDOW_RETENTION_DAYS=7  # default: 7 (or RETENTION_RATE_LIMIT_DAYS) | type: integer | accepted: base-10 days >= 1 | meaning: 7=keep burst limits 7 days | units: days | effect: sets burst_limits_window retention window
RETENTION_LOG_PATH=  # default: null | type: string | accepted: filesystem path | meaning: blank=no file logging, path=append retention logs | units: n/a | effect: enables file logging for retention cleanup

# Migrations
AUTO_RUN_MIGRATIONS=0  # default: false | type: boolean (parseBooleanEnv) | accepted: true/false/1/0 (case-insensitive) | meaning: 1/true=run migrations on startup, 0/false=skip | units: n/a | effect: controls auto-migration on server start

# Debug/Logging
DAVIX_DEBUG_INTERNAL=0  # default: disabled | type: string flag | accepted: "1" enables, any other value disables | meaning: 1=enabled, other=disabled | units: n/a | effect: enables internal debug logging (may log extra metadata)

# Subscription timing
VALID_FROM_GRACE_SECONDS=120  # default: 120 | type: number | accepted: base-10 seconds >= 0 | meaning: 120=2-minute grace | units: seconds | effect: adjusts valid_from grace when normalizing dates

# Script helpers (scripts only)
REPRO_BASE_URL=http://localhost:3005  # default: http://localhost:3005 | type: string URL | accepted: full URL with scheme/host/port | meaning: base URL for repro script | units: n/a | effect: controls target API for repro-all-endpoints.js
REPRO_API_KEY=  # default: empty | type: string | accepted: API key | meaning: key used by repro-all-endpoints.js | units: n/a | effect: authenticates repro requests
API_KEY=  # default: empty | type: string | accepted: API key | meaning: legacy fallback for REPRO_API_KEY | units: n/a | effect: used only if REPRO_API_KEY is unset
TEST_CUSTOMER_EMAIL=test@example.com  # default: test@example.com | type: string | accepted: email | meaning: customer email used by smoke scripts | units: n/a | effect: controls target customer in smoke scripts
TEST_PLAN_SLUG=dev-plan  # default: dev-plan | type: string | accepted: plan slug | meaning: plan slug used by customer-key-smoke.js | units: n/a | effect: selects plan for provisioning smoke test
TEST_SUBSCRIPTION_ID=  # default: empty | type: string | accepted: subscription ID | meaning: optional subscription filter for user-summary-smoke.js | units: n/a | effect: narrows summary to a subscription
