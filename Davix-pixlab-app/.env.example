# Environment
NODE_ENV=development
PORT=3005
BASE_URL=http://localhost:3005
TRUST_PROXY=true

# CORS
CORS_ORIGINS=https://h2i.davix.dev,https://davix.dev,https://www.davix.dev

# Auth
API_KEYS=
PUBLIC_API_KEYS=
DISABLE_QUERY_API_KEY_IN_PROD=1
SUBSCRIPTION_BRIDGE_TOKEN=
X_DAVIX_BRIDGE_TOKEN=

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=pixlab

# Signed output URLs
REQUIRE_SIGNED_OUTPUT_URLS=0
SIGNED_URL_SECRET=
SIGNED_URL_TTL_SECONDS=86400
SIGNED_URL_ALGO=sha256
OUTPUT_CACHE_CONTROL=private, no-store

# Request limits and timeouts
BODY_PARSER_JSON_LIMIT=20mb
MAX_UPLOAD_BYTES=
PUBLIC_TIMEOUT_MS=30000
OWNER_TIMEOUT_MS=300000

# HTML to image limits
MAX_HTML_CHARS=100000
MAX_RENDER_PIXELS=20000000
MAX_RENDER_WIDTH=5000
MAX_RENDER_HEIGHT=8000
H2I_BLOCK_PRIVATE_NETWORK=1
H2I_ALLOW_FILE_SCHEME=0
PUPPETEER_NO_SANDBOX=1

# Public daily rate limits
PUBLIC_H2I_DAILY_LIMIT=5
PUBLIC_IMAGE_DAILY_LIMIT=10
PUBLIC_PDF_DAILY_LIMIT=10
PUBLIC_TOOLS_DAILY_LIMIT=10

# Upload limits (public)
PUBLIC_IMAGE_MAX_FILES_PER_REQ=10
PUBLIC_IMAGE_MAX_TOTAL_UPLOAD_MB=10
PUBLIC_IMAGE_MAX_DIMENSION_PX=6000
PUBLIC_PDF_MAX_FILES_PER_REQ=10
PUBLIC_PDF_MAX_TOTAL_UPLOAD_MB=10
PUBLIC_TOOLS_MAX_FILES_PER_REQ=10
PUBLIC_TOOLS_MAX_TOTAL_UPLOAD_MB=10
PUBLIC_TOOLS_MAX_DIMENSION_PX=6000

# Upload limits (owner)
OWNER_MAX_FILES_PER_REQ=50
OWNER_IMAGE_MAX_TOTAL_UPLOAD_MB=
OWNER_IMAGE_MAX_DIMENSION_PX=
OWNER_PDF_MAX_TOTAL_UPLOAD_MB=
OWNER_TOOLS_MAX_TOTAL_UPLOAD_MB=
OWNER_TOOLS_MAX_DIMENSION_PX=

# Global ceilings
GLOBAL_MAX_TOTAL_UPLOAD_MB=
GLOBAL_MAX_FILES_PER_REQ=

# Output retention
PUBLIC_FILE_TTL_HOURS=24

# Burst throttling (customer keys)
CUSTOMER_BURST_LIMIT_PER_MIN=0
CUSTOMER_BURST_WINDOW_SECONDS=60

# Internal logging
DAVIX_DEBUG_INTERNAL=0

# Usage/retention
EXPIRY_WATCHER_ENABLED=true
EXPIRY_WATCHER_INTERVAL_MS=600000
EXPIRY_WATCHER_BATCH_SIZE=500
ORPHAN_CLEANUP_ENABLED=true
ORPHAN_CLEANUP_INTERVAL_MS=86400000
ORPHAN_CLEANUP_INITIAL_DELAY_MS=300000
ORPHAN_CLEANUP_BATCH=5000
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_MS=86400000
RETENTION_INITIAL_DELAY_MS=60000
RETENTION_REQUEST_LOG_DAYS=60
RETENTION_USAGE_MONTHLY_MONTHS=6
RETENTION_BATCH_REQUEST_LOG=20000
RETENTION_BATCH_USAGE_MONTHLY=5000
RETENTION_RATE_LIMIT_DAYS=30
RATE_LIMITS_DAILY_CLEANUP_ENABLED=true
RATE_LIMITS_DAILY_RETENTION_DAYS=2
BURST_LIMITS_WINDOW_CLEANUP_ENABLED=true
BURST_LIMITS_WINDOW_RETENTION_DAYS=7
RETENTION_LOG_PATH=

# Customer key provisioning
VALID_FROM_GRACE_SECONDS=120

# Script helpers
REPRO_BASE_URL=http://localhost:3005
REPRO_API_KEY=
API_KEY=
TEST_CUSTOMER_EMAIL=test@example.com
TEST_PLAN_SLUG=dev-plan
TEST_SUBSCRIPTION_ID=
