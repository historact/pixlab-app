# Public base URL used for links in notifications and snapshots (required).
PUBLIC_BASE_URL=https://pixlab.davix.dev

# Optional: override base URL used by the snapshot engine (defaults to PUBLIC_BASE_URL).
# SNAPSHOT_BASE_URL=https://pixlab.davix.dev

# Optional: explicitly set an internal base URL if you truly need localhost access.
# INTERNAL_BASE_URL=http://localhost:3005

# Trust proxy hop count (set to 1 for common single-hop TLS termination).
TRUST_PROXY=1

# Internal auth token for snapshot endpoints and bridge calls.
SUBSCRIPTION_BRIDGE_TOKEN=replace-me
