# Environment
NODE_ENV=development  # default: development (production enables stricter defaults)
PORT=3005  # default: 3005
BASE_URL=http://localhost:3005  # default: http://localhost:${PORT}
TRUST_PROXY=true  # default: true (set to false or number as needed)

# CORS
CORS_ORIGINS=https://h2i.davix.dev,https://davix.dev,https://www.davix.dev  # default: listed origins

# Auth
API_KEYS=  # REQUIRED in production (comma/space-separated)
PUBLIC_API_KEYS=  # default: empty (subset of API_KEYS treated as public)
DISABLE_QUERY_API_KEY_IN_PROD=1  # default: true (blocks api_key query param in prod)
SUBSCRIPTION_BRIDGE_TOKEN=  # recommended in production (internal routes)
X_DAVIX_BRIDGE_TOKEN=  # legacy bridge token (scripts)

# Database
DB_HOST=localhost  # default: localhost (REQUIRED in production)
DB_USER=root  # default: root (REQUIRED in production)
DB_PASS=  # default: empty
DB_NAME=pixlab  # default: pixlab (REQUIRED in production)

# Signed output URLs
REQUIRE_SIGNED_OUTPUT_URLS=0  # default: true in production, false otherwise
SIGNED_URL_SECRET=  # REQUIRED in production when REQUIRE_SIGNED_OUTPUT_URLS=true
SIGNED_URL_TTL_SECONDS=86400  # default: 86400 (24h)
SIGNED_URL_ALGO=sha256  # default: sha256
OUTPUT_CACHE_CONTROL=private, no-store  # default: private, no-store

# Request limits and timeouts
BODY_PARSER_JSON_LIMIT=20mb  # default: 20mb
MAX_UPLOAD_BYTES=  # default: none (bytes)
PUBLIC_TIMEOUT_MS=30000  # default: 30000
OWNER_TIMEOUT_MS=300000  # default: 300000

# HTML to image limits
MAX_HTML_CHARS=100000  # default: 100000
MAX_RENDER_PIXELS=20000000  # default: 20000000
MAX_RENDER_WIDTH=5000  # default: 5000
MAX_RENDER_HEIGHT=8000  # default: 8000
H2I_BLOCK_PRIVATE_NETWORK=1  # default: true
H2I_ALLOW_FILE_SCHEME=0  # default: false
H2I_DNS_REBINDING_MODE=  # default: strict in production when H2I_BLOCK_PRIVATE_NETWORK=true, else off
PUPPETEER_NO_SANDBOX=1  # default: true in non-production, false in production

# Public daily rate limits
PUBLIC_H2I_DAILY_LIMIT=5  # default: 5
PUBLIC_IMAGE_DAILY_LIMIT=10  # default: 10
PUBLIC_PDF_DAILY_LIMIT=10  # default: 10
PUBLIC_TOOLS_DAILY_LIMIT=10  # default: 10

# Upload limits (public)
PUBLIC_IMAGE_MAX_FILES_PER_REQ=10  # default: 10
PUBLIC_IMAGE_MAX_TOTAL_UPLOAD_MB=10  # default: 10
PUBLIC_IMAGE_MAX_DIMENSION_PX=6000  # default: 6000
PUBLIC_PDF_MAX_FILES_PER_REQ=10  # default: 10
PUBLIC_PDF_MAX_TOTAL_UPLOAD_MB=10  # default: 10
PUBLIC_TOOLS_MAX_FILES_PER_REQ=10  # default: 10
PUBLIC_TOOLS_MAX_TOTAL_UPLOAD_MB=10  # default: 10
PUBLIC_TOOLS_MAX_DIMENSION_PX=6000  # default: 6000

# Upload limits (owner)
OWNER_MAX_FILES_PER_REQ=50  # default: 50
OWNER_IMAGE_MAX_TOTAL_UPLOAD_MB=  # default: none
OWNER_IMAGE_MAX_DIMENSION_PX=  # default: none
OWNER_PDF_MAX_TOTAL_UPLOAD_MB=  # default: none
OWNER_TOOLS_MAX_TOTAL_UPLOAD_MB=  # default: none
OWNER_TOOLS_MAX_DIMENSION_PX=  # default: none

# Global ceilings
GLOBAL_MAX_TOTAL_UPLOAD_MB=  # default: none
GLOBAL_MAX_FILES_PER_REQ=  # default: none

# Output retention
PUBLIC_FILE_TTL_HOURS=24  # default: 24

# Burst throttling (customer keys)
CUSTOMER_BURST_LIMIT_PER_MIN=0  # default: 0 (disabled)
CUSTOMER_BURST_WINDOW_SECONDS=60  # default: 60
CUSTOMER_BURST_APPLIES_TO=h2i  # default: h2i (or all)
RATE_LIMIT_DB_FAILURE_MODE=memory  # default: memory (open|closed|memory)

# Internal logging
DAVIX_DEBUG_INTERNAL=0  # default: 0

# Usage/retention
EXPIRY_WATCHER_ENABLED=true  # default: true
EXPIRY_WATCHER_INTERVAL_MS=600000  # default: 600000
EXPIRY_WATCHER_BATCH_SIZE=500  # default: 500
ORPHAN_CLEANUP_ENABLED=true  # default: true
ORPHAN_CLEANUP_INTERVAL_MS=86400000  # default: 86400000
ORPHAN_CLEANUP_INITIAL_DELAY_MS=300000  # default: 300000
ORPHAN_CLEANUP_BATCH=5000  # default: 5000
RETENTION_CLEANUP_ENABLED=true  # default: true
RETENTION_CLEANUP_INTERVAL_MS=86400000  # default: 86400000
RETENTION_INITIAL_DELAY_MS=60000  # default: 60000
RETENTION_REQUEST_LOG_DAYS=60  # default: 60
RETENTION_USAGE_MONTHLY_MONTHS=6  # default: 6
RETENTION_BATCH_REQUEST_LOG=20000  # default: 20000
RETENTION_BATCH_USAGE_MONTHLY=5000  # default: 5000
RETENTION_RATE_LIMIT_DAYS=  # default: falls back to rate limit defaults (2/7 days)
RATE_LIMITS_DAILY_CLEANUP_ENABLED=true  # default: true
RATE_LIMITS_DAILY_RETENTION_DAYS=2  # default: 2 (unless RETENTION_RATE_LIMIT_DAYS set)
BURST_LIMITS_WINDOW_CLEANUP_ENABLED=true  # default: true
BURST_LIMITS_WINDOW_RETENTION_DAYS=7  # default: 7 (unless RETENTION_RATE_LIMIT_DAYS set)
RETENTION_LOG_PATH=  # default: null

# Migrations
AUTO_RUN_MIGRATIONS=0  # default: false

# Customer key provisioning
VALID_FROM_GRACE_SECONDS=120  # default: 120

# Script helpers
REPRO_BASE_URL=http://localhost:3005  # default: http://localhost:3005
REPRO_API_KEY=  # default: empty
API_KEY=  # default: empty (repro script)
TEST_CUSTOMER_EMAIL=test@example.com  # default: test@example.com
TEST_PLAN_SLUG=dev-plan  # default: dev-plan
TEST_SUBSCRIPTION_ID=  # default: empty
